# ---- PingFederate ----
# Runtime base URL (port 9031) as reachable from THIS laptop
PF_BASE_URL=https://172.22.127.250:9031
# Issuer PingFederate puts in tokens (= its configured Base URL). Leave empty to use PF_BASE_URL.
PF_ISSUER=
# Lab only: PingFederate uses a self-signed certificate. Set to false once it has a trusted one.
PF_TLS_INSECURE=true

# ---- OpenID Connect client (created by setup-pingfed.js) ----
OIDC_CLIENT_ID=pflab-node-app
OIDC_CLIENT_SECRET=change-me-in-.env
OIDC_SCOPES=openid profile email

# ---- SAML SP (this app) ----
SAML_SP_ENTITY_ID=pflab-node-app
# PingFederate's SAML 2.0 Entity ID (System > Server > Protocol Settings > Federation Info)
SAML_IDP_ENTITY_ID=pingfed-lab-idp
# PingFederate signing certificate (PEM file exported from Security > Signing & Decryption Keys)
SAML_IDP_CERT_FILE=./pingfed-signing.crt

# ---- App ----
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string
